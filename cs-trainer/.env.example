# AI Provider: "cloud" (Claude API) or "local" (Ollama)
AI_MODE=cloud

# Anthropic Claude API key (required for cloud mode)
ANTHROPIC_API_KEY=your-key-here

# Ollama URL (for local mode or fallback)
OLLAMA_URL=http://localhost:11434

# CORS allowed origins (comma separated)
ALLOWED_ORIGINS=http://localhost:5173
